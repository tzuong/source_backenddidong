# Copy this file as .env and fill passwords matching the Mosquitto accounts.
# API is local to this PC. Do not expose it to the Internet without production security.
HTTP_HOST=127.0.0.1
PORT=3000
API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=SET_BACKEND_MQTT_PASSWORD
SIMULATOR_USERNAME=simulator
SIMULATOR_PASSWORD=SET_SIMULATOR_MQTT_PASSWORD
